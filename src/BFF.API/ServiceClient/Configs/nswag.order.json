{
  "// Run": "nswag run src/BFF.API/ServiceClient/Configs/nswag.order.json",
  "runtime": "Net100",
  "documentGenerator": {
    "fromDocument": {
      "url": "../../../Order.API/swagger.json"
    }
  },
  "codeGenerators": {
    "openApiToCSharpClient": {
      "namespace": "BFF.API.ServiceClient.Order",
      "className": "OrderApiClient",
      "injectHttpClient": true,
      "generateClientInterfaces": true,
      "generateExceptionClasses": true,
      "output": "../OrderApiClient.cs"
    }
  }
}
