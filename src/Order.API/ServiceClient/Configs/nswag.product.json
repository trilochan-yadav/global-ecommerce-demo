{
  "// Run": "nswag run src/Order.API/ServiceClient/Configs/nswag.product.json",
  "runtime": "Net100",
  "documentGenerator": {
    "fromDocument": {
      "url": "../../../Product.API/swagger.json"
    }
  },
  "codeGenerators": {
    "openApiToCSharpClient": {
      "namespace": "Order.API.ServiceClient.Product",
      "className": "ProductApiClient",
      "injectHttpClient": true,
      "generateClientInterfaces": true,
      "generateExceptionClasses": true,
      "output": "../ProductApiClient.cs"
    }
  }
}
