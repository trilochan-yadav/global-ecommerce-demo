{
  "name": "Docker - docker-compose",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [4200, 7000, 7001, 7002, 7003, 7004, 7005, 5341],
  "portsAttributes": {
    "4200": { "label": "Angular App" },
    "7000": { "label": "BFF API" },
    "7001": { "label": "Product API" },
    "7002": { "label": "Order API" },
    "7003": { "label": "Payment API" },
    "7004": { "label": "Shipping API" },
    "7005": { "label": "Analytics API" },
    "5341": { "label": "Seq Logs" }
  },
  "postCreateCommand": "dotnet restore",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
