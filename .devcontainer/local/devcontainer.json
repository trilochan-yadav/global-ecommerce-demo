{
  "name": "Local - dotnet run (no Docker)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "forwardPorts": [7000, 7001, 7002, 7003, 7004, 7005],
  "portsAttributes": {
    "7000": { "label": "BFF API" },
    "7001": { "label": "Product API" },
    "7002": { "label": "Order API" },
    "7003": { "label": "Payment API" },
    "7004": { "label": "Shipping API" },
    "7005": { "label": "Analytics API" }
  },
  "postCreateCommand": "dotnet restore",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ]
    }
  }
}
